// The icon and version information of BioForgeSDL.exe; package-windows.ps1 compiles it with rc.exe and links it in.
// AppIcon.ico is native/Resources/AppIcon.png (original artwork, not GOG's) at 16 to 256 pixels, made with Pillow:
//   Image.open("AppIcon.png").save("AppIcon.ico", sizes=[(16,16),(24,24),(32,32),(48,48),(64,64),(128,128),(256,256)])
#include <winver.h>

1 ICON "AppIcon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "BioForge"
            VALUE "ProductName", "BioForge (unofficial port)"
            VALUE "FileVersion", "0.1"
            VALUE "ProductVersion", "0.1"
            VALUE "OriginalFilename", "BioForgeSDL.exe"
            VALUE "LegalCopyright", "BioForge is a trademark of Electronic Arts Inc. Unofficial fan port; no game data included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
